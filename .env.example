# Real Google reviews (server-side only; do not prefix with NEXT_PUBLIC_)
# Option 1 (free): Featurable widget ID from https://featurable.com → Embed → API
FEATURABLE_WIDGET_ID=
# Option 2: Google Places API (New)
GOOGLE_PLACES_API_KEY=
# Optional. Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Optional GA4 measurement ID
NEXT_PUBLIC_GA_ID=

# Live domain, used for canonical tags, sitemap and schema (e.g. https://nationalfilings.co.in)
NEXT_PUBLIC_SITE_URL=
# Set to true ONLY on the live domain at launch. Anything else sends noindex on every URL.
SITE_INDEXABLE=

# Contact form: Google Sheet web app URL from scripts/lead-sheet.gs (required in production)
LEAD_WEBHOOK_URL=
# Any long random string; must match SECRET in the script so only this site can add rows
LEAD_WEBHOOK_SECRET=
